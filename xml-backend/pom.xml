<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.8</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.example</groupId>
	<artifactId>xml-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>
		<jjwt.version>0.13.0</jjwt.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.xmlgraphics</groupId>
			<artifactId>fop</artifactId>
			<version>2.11</version>
			<exclusions>
				<!-- Java 17 already provides these XML APIs; avoid duplicate packages in Eclipse. -->
				<exclusion>
					<groupId>xml-apis</groupId>
					<artifactId>xml-apis</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>
		<dependency>
			<groupId>jakarta.xml.bind</groupId>
			<artifactId>jakarta.xml.bind-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>jaxb2-maven-plugin</artifactId>
				<version>4.0.0</version>
				<executions>
					<execution>
						<id>generate-a1-model</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>xjc</goal>
						</goals>
						<configuration>
							<!-- Compile the imported A-1 model and list together: one copy of each type. -->
							<sources>
								<source>${project.basedir}/src/main/resources/a1-zahtev.xsd</source>
								<source>${project.basedir}/src/main/resources/a1-lista.xsd</source>
							</sources>
							<packageName>com.example.xml_backend.model.a1</packageName>
							<outputDirectory>${project.build.directory}/generated-sources/jaxb/a1</outputDirectory>
						</configuration>
					</execution>
					<execution>
						<id>generate-registracija-model</id>
						<phase>generate-sources</phase>
						<goals><goal>xjc</goal></goals>
						<configuration>
							<sources><source>${project.basedir}/src/main/resources/registracija.xsd</source></sources>
							<packageName>com.example.xml_backend.model.registracija</packageName>
							<outputDirectory>${project.build.directory}/generated-sources/jaxb/registracija</outputDirectory>
						</configuration>
					</execution>
					<execution>
						<id>generate-korisnik-model</id>
						<phase>generate-sources</phase>
						<goals><goal>xjc</goal></goals>
						<configuration>
							<sources><source>${project.basedir}/src/main/resources/korisnik.xsd</source></sources>
							<packageName>com.example.xml_backend.model.korisnik</packageName>
							<outputDirectory>${project.build.directory}/generated-sources/jaxb/korisnik</outputDirectory>
						</configuration>
					</execution>
					<execution>
						<id>generate-prijava-model</id>
						<phase>generate-sources</phase>
						<goals><goal>xjc</goal></goals>
						<configuration>
							<sources><source>${project.basedir}/src/main/resources/prijava.xsd</source></sources>
							<packageName>com.example.xml_backend.model.prijava</packageName>
							<outputDirectory>${project.build.directory}/generated-sources/jaxb/prijava</outputDirectory>
						</configuration>
					</execution>
					<execution>
						<id>generate-prijava-odgovor-model</id>
						<phase>generate-sources</phase>
						<goals><goal>xjc</goal></goals>
						<configuration>
							<sources><source>${project.basedir}/src/main/resources/prijava-odgovor.xsd</source></sources>
							<packageName>com.example.xml_backend.model.prijavaodgovor</packageName>
							<outputDirectory>${project.build.directory}/generated-sources/jaxb/prijavaodgovor</outputDirectory>
						</configuration>
					</execution>
					<execution>
						<id>generate-odluka-model</id>
						<phase>generate-sources</phase>
						<goals><goal>xjc</goal></goals>
						<configuration>
							<sources><source>${project.basedir}/src/main/resources/odluka.xsd</source></sources>
							<packageName>com.example.xml_backend.model.odluka</packageName>
							<outputDirectory>${project.build.directory}/generated-sources/jaxb/odluka</outputDirectory>
						</configuration>
					</execution>
					<execution>
						<id>generate-resenje-model</id>
						<phase>generate-sources</phase>
						<goals><goal>xjc</goal></goals>
						<configuration>
							<sources><source>${project.basedir}/src/main/resources/resenje.xsd</source></sources>
							<packageName>com.example.xml_backend.model.resenje</packageName>
							<outputDirectory>${project.build.directory}/generated-sources/jaxb/resenje</outputDirectory>
						</configuration>
					</execution>
					<execution>
						<id>generate-a1-pretraga-model</id>
						<phase>generate-sources</phase>
						<goals><goal>xjc</goal></goals>
						<configuration>
							<sources><source>${project.basedir}/src/main/resources/a1-pretraga.xsd</source></sources>
							<packageName>com.example.xml_backend.model.a1pretraga</packageName>
							<outputDirectory>${project.build.directory}/generated-sources/jaxb/a1pretraga</outputDirectory>
						</configuration>
					</execution>
				</executions>
				<configuration>
					<!-- Each execution clears only its own output directory and registers it as a source root. -->
					<clearOutputDir>true</clearOutputDir>
					<encoding>UTF-8</encoding>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
